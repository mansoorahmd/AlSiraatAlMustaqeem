{
  "name": "@alsiraat/corpus-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Qur'an corpus code (search, roots, similarity, …) and its routes — run by the research server over Postgres, and by the MCP and the tests over quran.db (node:sqlite).",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "corpus": "cross-env NODE_NO_WARNINGS=1 NODE_OPTIONS=--experimental-sqlite tsx src/corpus/cli.ts",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
