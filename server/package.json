{
  "name": "@alsiraat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AlSiraatAlMustaqeem API — TypeScript port of the FastAPI backend (Hono + node:sqlite).",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 tsx watch src/server.ts",
    "start": "cross-env NODE_NO_WARNINGS=1 tsx src/server.ts",
    "start:static": "cross-env NODE_NO_WARNINGS=1 SERVE_STATIC=1 tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
