{
  "name": "alsiraat-almustaqeem",
  "private": true,
  "version": "0.2.0",
  "description": "MQ Research Gate — a detective-style Quran study app (React SPA + the research server).",
  "main": "electron/main.mjs",
  "workspaces": [
    "app",
    "corpus-core",
    "mcp",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @alsiraat/server\" \"npm run dev -w app\"",
    "test": "npm test -w @alsiraat/corpus-core && npm test -w @alsiraat/server",
    "typecheck": "npm run typecheck -w @alsiraat/corpus-core && npm run typecheck -w app && npm run typecheck -w @alsiraat/mcp && npm run typecheck -w @alsiraat/server",
    "server:dev": "npm run dev -w @alsiraat/server",
    "server:migrate": "npm run migrate -w @alsiraat/server",
    "server:demo": "npm run demo:claims -w @alsiraat/server --",
    "server:demo:keep": "npm run demo:claims -w @alsiraat/server -- --keep",
    "server:diagnose": "npm run diagnose:pull -w @alsiraat/server",
    "server:demo:clean": "npm run demo:clean -w @alsiraat/server",
    "corpus:migrate": "npm run corpus:migrate -w @alsiraat/server --",
    "corpus:parity": "npm run corpus:parity -w @alsiraat/server --",
    "access": "npm run access -w @alsiraat/server --",
    "build": "npm run build -w app",
    "start": "npm run build -w app && npm run preview -w app",
    "mcp": "npm start --silent -w @alsiraat/mcp",
    "electron:dev": "npm run build -w app && electron .",
    "desktop:dist": "npm run build -w app && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.1.0"
  }
}
