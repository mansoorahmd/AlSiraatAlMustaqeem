{
  "name": "@alsiraat/remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MQ Research Gate — the research server: the corpus, accounts, research and the community (Postgres + Better Auth).",
  "main": "src/server.ts",
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 tsx watch src/server.ts",
    "start": "cross-env NODE_NO_WARNINGS=1 tsx src/server.ts",
    "migrate": "cross-env NODE_NO_WARNINGS=1 tsx src/migrate-cli.ts",
    "bootstrap": "cross-env NODE_NO_WARNINGS=1 tsx src/bootstrap-cli.ts",
    "set-password": "cross-env NODE_NO_WARNINGS=1 tsx src/set-password-cli.ts",
    "set-plan": "cross-env NODE_NO_WARNINGS=1 tsx src/set-plan-cli.ts",
    "corpus:migrate": "cross-env NODE_NO_WARNINGS=1 tsx src/corpus-migrate-cli.ts",
    "corpus:parity": "cross-env NODE_NO_WARNINGS=1 tsx src/corpus-parity-cli.ts",
    "access": "cross-env NODE_NO_WARNINGS=1 tsx src/access-cli.ts",
    "smoke": "cross-env NODE_NO_WARNINGS=1 tsx src/smoke-cli.ts",
    "demo:claims": "cross-env NODE_NO_WARNINGS=1 tsx src/demo-claims-cli.ts",
    "diagnose:pull": "cross-env NODE_NO_WARNINGS=1 tsx src/diagnose-pull-cli.ts",
    "demo:clean": "cross-env NODE_NO_WARNINGS=1 tsx src/demo-clean-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-auth": "^1.4.0",
    "hono": "^4.6.14",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
