{
  "name": "@alsiraat/remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MQ Research Gate — remote research channel (Postgres + Better Auth). Separate from the local API.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 tsx watch src/server.ts",
    "start": "cross-env NODE_NO_WARNINGS=1 tsx src/server.ts",
    "migrate": "cross-env NODE_NO_WARNINGS=1 tsx src/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
