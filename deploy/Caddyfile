# HTTPS in front of the research server. Caddy fetches and renews a Let's Encrypt certificate
# for {$DOMAIN} by itself — the DNS A/AAAA record must point at this machine first.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# requests are small JSON — except bringing a research.db into an account (up to 100 MB)
	@import path /research/import
	@other not path /research/import
	request_body @import {
		max_size 100MB
	}
	request_body @other {
		max_size 5MB
	}
	reverse_proxy remote:8100 {
		health_uri /health
	}
}
