# HTTPS in front of the research server. Caddy fetches and renews a Let's Encrypt certificate
# for {$DOMAIN} by itself — the DNS A/AAAA record must point at this machine first.
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}
	# the corpus answers can be large; everything else is small JSON
	request_body {
		max_size 5MB
	}
	reverse_proxy remote:8100 {
		health_uri /health
	}
}
