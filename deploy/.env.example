# Copy to deploy/.env and fill in. deploy/.env is git-ignored — it holds secrets.

# The public name of the research server. Point its DNS A (and AAAA) record at this VPS first.
DOMAIN=research.example.org

# Generate both:  openssl rand -base64 48
POSTGRES_PASSWORD=
AUTH_SECRET=

# Password-reset emails, through any SMTP server.
#   Google Workspace: smtp.gmail.com 587, user = the mailbox, pass = an app password
#   Microsoft 365:    smtp.office365.com 587
#   Mailgun / SES / Postmark / Brevo: their SMTP host, port 587, the SMTP credentials they give you
EMAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MQ Research Gate <no-reply@example.org>

# Leave empty to allow the app's own local origins (desktop 51789, npm start 8000, dev 5174).
TRUSTED_ORIGINS=
